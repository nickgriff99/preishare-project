# Supabase (required for production auth + database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public site URL (OAuth redirects, Stripe success/cancel URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Show portfolio demo banner on the live site (set to true in Netlify production)
NEXT_PUBLIC_DEMO_MODE=false

# Server-only Supabase key (Stripe webhooks, admin writes)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (test mode keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Phase 2 (optional)
# GHL_API_KEY=
# GHL_LOCATION_ID=
